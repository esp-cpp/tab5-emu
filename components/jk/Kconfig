menu "Jedi Knight (OpenJKDF2)"

    config JK_ENGINE
        bool "Build the OpenJKDF2 engine"
        default y
        help
            Compile and link the OpenJKDF2 engine (components/jk/OpenJKDF2).
            When disabled the Jedi Knight cart shows an animated test pattern,
            which is useful to bring up the video / input / audio paths.

    config JK_INTERNAL_WIDTH
        int "Internal render width"
        default 426
        help
            Width of the 8-bit frame the engine renders the world into. It is
            scaled to the screen by the PPA.

    config JK_INTERNAL_HEIGHT
        int "Internal render height"
        default 240

    config JK_MENU_WIDTH
        int "Menu buffer width"
        default 640
        help
            The 2D GUI is laid out for 640x480; keep it unless the GUI code is
            changed (JKGUI_SMOL_SCREEN halves it to 320x240 on the DSi).

    config JK_MENU_HEIGHT
        int "Menu buffer height"
        default 480

    config JK_ESP_DEBUG
        bool "Engine bring-up instrumentation (I/O timers, sampling profiler)"
        default n
        help
            Adds file-system / allocator timing counters and a tick-hook
            sampling profiler (results on the console, symbolize with
            addr2line). Costs some console output and a little CPU.

    config JK_ENGINE_ARGS
        string "Engine command line"
        default ""
        help
            Passed to the engine as its command line, e.g.
            "-autostart -sp -episode JK1 -map 01narshadda" to jump straight
            into a level (bring-up aid).

    config JK_AUDIO_SAMPLE_RATE
        int "Audio mixer sample rate"
        default 22050

    menu "Engine table sizes"
        depends on JK_ENGINE
        comment "Allocated when Jedi Knight starts and freed when it quits"

        config JK_SITHAI_MAX_ACTORS
            int "AI actors per level (SITHAI_MAX_ACTORS)"
            range 32 1024
            default 128
            help
                Entries in the engine's AI actor table, 672 bytes each (128 =
                84 KB). A level with more AI-driven things than this loads the
                rest without AI (they stand still). The PC engine uses 256.

        config JK_FS_DIR_CACHE_ENTRIES
            int "Directory cache entries (JK_ESP_FS_DIRCACHE)"
            range 16 4096
            default 512
            help
                The port remembers whether each directory it probed on the SD
                card exists, so the engine's many file lookups do not repeat
                FatFs directory scans: 129 bytes per entry (512 = 64.5 KB).
                When it is full, new directories are asked of the card each
                time (slower level loads, nothing else).

        config JK_RDACTIVE_MAX_FACES
            int "Active-edge rasterizer faces (RDACTIVE_MAX_FACES)"
            range 256 8192
            default 1024
            help
                Face pool of the engine's active-edge (painter's) software
                rasterizer, 512 bytes per face. This port draws the world with
                the z-buffered rasterizer (RDRASTER_SW_ZBUFFER), so the pool is
                not allocated at all; the size only matters for an engine built
                without RDRASTER_SW_ZBUFFER.

        config JK_RDACTIVE_MAX_SPANS
            int "Active-edge rasterizer spans (RDACTIVE_MAX_SPANS)"
            range 256 16384
            default 2048
            help
                Span pool of the same rasterizer, 52 bytes per span (not
                allocated with RDRASTER_SW_ZBUFFER, see above).
    endmenu

endmenu
