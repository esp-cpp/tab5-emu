menu "Star Wars Episode I: The Phantom Menace (tpm-decomp)"

    config TPM_ENGINE
        bool "Build the game (static recompilation of your SLUS_008.84)"
        default y
        help
            Recompile the game's executable to C at configure time
            (tpm-decomp/tools/recomp.py) and build it with tpm-decomp's
            runtime on psyz. Needs the USA Rev 1 executable at
            TPM_EXE_PATH; without it the build carries on and the cart shows
            the game's load screens (the data and display path) instead.

    config TPM_EXE_PATH
        string "Path of SLUS_008.84 (USA Rev 1), relative to the project"
        default "components/tpm/tpm-decomp/disks/us/SLUS_008.84"
        depends on TPM_ENGINE
        help
            Your own copy of the game's executable, e.g. extracted with
            tpm-decomp/tools/extract_disc.py. It is only read at build time;
            nothing derived from it is committed.

    config TPM_SLIDE_SECONDS
        int "Seconds per load screen in the data viewer"
        default 4

    config TPM_GPU_WORKERS
        int "GPU workers (1: core 1 draws; 2: both cores, a band of rows each)"
        default 1
        range 1 2
        depends on TPM_ENGINE
        help
            With 2 the second worker runs on the game's core above it. On
            this board it measured slower: both cores then contend for PSRAM
            and the cache with the game's recompiled code.

    config TPM_GPU_BENCH_FILE
        string "Test: GPU benchmark recording to embed (rt_gpu_record file)"
        default ""
        depends on TPM_ENGINE
        help
            A recording made by tpm-decomp's desktop runner (--gpu-record):
            embedded in the firmware and replayed through the rasterizer on
            core 1 when the cart starts, printing "TPMBENCH <us> us per
            vblank". Only for measuring the rasterizer.

    config TPM_AUTOPRESS
        string "Test: scripted button presses (vblank:button,...)"
        default ""
        depends on TPM_ENGINE
        help
            Bring-up aid: press pad buttons at given vblanks without anyone
            at the board, e.g. "300:cross,600:cross,900:start". Each press
            is held for 8 vblanks. Buttons: cross circle square triangle
            start select up down left right l1 r1 l2 r2.

    config TPM_SERIAL_SCREENSHOT_SECONDS
        int "Test: print the screen on the console every N seconds (0 = off)"
        default 0
        depends on TPM_ENGINE
        help
            Bring-up aid: the presented 320x240 RGB565 frame as base64 lines
            ("TPMFB ..."), for tools/serial_screenshots.py to turn into
            PNGs.

    config TPM_SERIAL_FULL_SHOT_VBLANK
        int "Test: print all of VRAM (half resolution) once, at this vblank (0 = off)"
        default 0
        depends on TPM_SERIAL_SCREENSHOT_SECONDS > 0

    config TPM_GPU_TRACE_VBLANK
        int "Test: log the GPU state commands of this frame (0 = off)"
        default 0
        depends on TPM_ENGINE
        help
            Compare with the desktop runner's --gpu-trace N.

    config TPM_PROFILE_VBLANK
        int "Test: sample the game thread's PC for 8000 ticks from this vblank (0 = off)"
        default 0
        depends on TPM_ENGINE

endmenu
