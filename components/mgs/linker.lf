# Metal Gear Solid: where the game's statics live, and how to find them again.
#
# Everything the decompiled game, psyz, the PSY-Q libraries and the port keep
# in .bss / COMMON goes to PSRAM (internal RAM is the Tab5's scarce memory);
# their .data goes into .flash.rodata, which this build runs XIP from PSRAM
# and is therefore writable (memory protection is off for it, see
# sdkconfig.defaults) and arrives initialised and relocated by the normal
# image load. The SURROUND symbols (_mgs_bss_start/_end, _mgs_common_*,
# _mgs_xbss_*, _mgs_data_*) let src/mgs.cpp put every static back between
# launches: the PSX booted from scratch every time and the game assumes it.
[scheme:mgs_statics]
entries:
    bss -> extern_ram
    common -> extern_ram
    extram_bss -> extern_ram
    data -> flash_rodata

[mapping:mgs]
archive: libmgs.a
entries:
    * (mgs_statics);
        bss -> extern_ram SURROUND(mgs_bss),
        common -> extern_ram SURROUND(mgs_common),
        extram_bss -> extern_ram SURROUND(mgs_xbss),
        data -> flash_rodata SURROUND(mgs_data)
    # the cart-side glue owns the reset itself (the .data snapshot, the
    # lifecycle state) and must survive it: default placement
    mgs (default)
    mgs_platform (default)
