CONFIG_IDF_TARGET="esp32p4"

# Tab5 ships an older ESP32-P4 silicon revision (< v3); ESP-IDF >= 6.0 needs
# this to accept it.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
# v0.1 or later (the Tab5's is v1.3): v0.0 cannot run the flash at 80 MHz,
# and the firmware executes from flash (see the PSRAM section below)
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# No C++ exceptions or RTTI: nothing in the firmware needs them (the games
# and emulator cores are C; the C++ glue checks allocations instead of
# catching bad_alloc), and they cost code size and unwind tables in PSRAM.
# CONFIG_COMPILER_CXX_EXCEPTIONS is not set
# CONFIG_COMPILER_CXX_RTTI is not set

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# disable the watchdogs; the game loop is allowed to hog a core
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# M5Stack Tab5 BSP
CONFIG_M5STACK_TAB5_INTERRUPT_STACK_SIZE=8192
CONFIG_M5STACK_TAB5_AUDIO_TASK_STACK_SIZE=8192

# PSRAM: 32 MB hex PSRAM on the Tab5; the game engine heap lives here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# Code executes from flash, not from a copy in PSRAM (CONFIG_SPIRAM_XIP_FROM_PSRAM,
# which costs 12.7 MB of PSRAM: all of .text and .rodata). The game cores'
# code and tables, which need the speed, share one PSRAM overlay instead:
# only the running game's core is there (components/tab5-emu/overlay.ld,
# about 1.1 MB). The cores' initialised data lives in PSRAM (.ext_ram.data,
# components/tab5-emu/ext_ram_data.ld), kept out of the heap with the noinit
# range.
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_USE_MALLOC=y
# Every plain malloc / new goes to PSRAM first, whatever its size (as on the
# box): internal RAM is the scarce resource on the P4 (SD DMA buffers, USB,
# tiles), and code that needs internal or DMA memory asks for it with
# heap_caps_malloc. (256 sent everything of 256 bytes or less to internal RAM
# first: the launcher's game titles, every small std::string and map node,
# which left Metal Gear Solid without DMA memory.)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
# reserve internal memory for DMA / task stacks
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# the game engine's static state is mapped to PSRAM (components/jk/linker.lf)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Memory protection is off: the cores' code runs from PSRAM (the overlay,
# which the loader writes), and with protection on the PMP keeps PSRAM from
# executing (and, with XIP from PSRAM, keeps the cores' data in .rodata
# read-only). Nothing untrusted runs here; it is only the W^X split that is
# lost.
CONFIG_ESP_SYSTEM_MEMPROT=n
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

#
# FATFS config
#
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=16384
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_MAX_LFN=255

# LVGL
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_BUILD_EXAMPLES=n
# LVGL allocates through the C heap (large blocks land in PSRAM) instead of a
# static internal-RAM pool, which does not fit next to the P4's other .bss.
# LVGL allocates from PSRAM (components/tab5-emu/src/lv_mem_core_psram.c)
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_THEME_DEFAULT_GROW=y
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=30
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# LVGL: load boxart straight from the SD card (baseline JPEG via TJpgDec)
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH=""
CONFIG_LV_FS_POSIX_CACHE_SIZE=4096
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_SNAPSHOT=y
# no custom assert handler header (the old "assert.h" default is deprecated in
# LVGL 9.6 and its #warning is an error under -Werror)
CONFIG_LV_ASSERT_HANDLER_INCLUDE=""

# USB host on the USB-A port: keyboard / mouse (HID), through hubs too
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# the P4's USB DMA can read PSRAM; internal RAM is too scarce for the
# 512-byte-aligned transfer descriptor lists once the game is running
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

# LVGL image cache (PSRAM via lv_malloc): without it the JPEG decoder yields
# partially decoded images, which LVGL cannot scale (boxart never showed)
CONFIG_LV_CACHE_DEF_SIZE=65536

# USB mass storage (espp::UsbDevice MSC over the SD card)
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
# the composite USB device: the console on CDC, the link services on a
# vendor interface (TX holds a whole reply frame: 4 KiB + header; RX is a
# stream the dispatcher reassembles). These FIFOs are internal RAM.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_CDC_RX_BUFSIZE=512
CONFIG_TINYUSB_CDC_TX_BUFSIZE=2048
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=1024
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=4608
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FATFS_USE_LABEL=y

# core dumps to flash (printed base64 on the next boot, see Tab5Emu::dump_core_dump_to_console)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# NOT 400 MHz: this Tab5 (chip v1.3, eco2 ROM) boot-loops in the ROM clock setup
# (Store/AMO fault at 0x50091000) with CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400.
# The UART console is a byte-at-a-time sink nobody reads (the capture is on
# USB); at 115200 a game printf stalls its thread 87 us per character.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
# Light heap poisoning: canaries around every block, so corruption is caught
# by heap_caps_check_integrity_all() near its source.
CONFIG_HEAP_POISONING_LIGHT=y
