CONFIG_IDF_TARGET="esp32p4"

# Tab5 ships an older ESP32-P4 silicon revision (< v3); ESP-IDF >= 6.0 needs
# this to accept it.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=y

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x9000
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# disable the watchdogs; the game loop is allowed to hog a core
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_ESP_TIMER_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_USE_FRAME_POINTER=y

CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# M5Stack Tab5 BSP
CONFIG_M5STACK_TAB5_INTERRUPT_STACK_SIZE=8192
CONFIG_M5STACK_TAB5_AUDIO_TASK_STACK_SIZE=8192

# PSRAM: 32 MB hex PSRAM on the Tab5; the game engine heap lives here.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
# anything larger than this is attempted to allocate within SPIRAM first
# small plain-malloc allocations (LVGL objects, strings) go to PSRAM too:
# internal RAM is the scarce resource on the P4 (SD DMA buffers, USB, tiles)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# reserve internal memory for DMA / task stacks
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=131072
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# the game engine's static state is mapped to PSRAM (components/jk/linker.lf)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# The MGS core keeps the game's initialized data in the PSRAM-XIP .rodata
# (tools/bss_to_psram.py --data); the PMP rules memory protection installs
# make that range read-only and are locked, so protection is off. Nothing
# untrusted runs here, and it is only the IRAM/DRAM W^X split that is lost.
CONFIG_ESP_SYSTEM_MEMPROT=n
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

#
# FATFS config
#
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=16384
CONFIG_FATFS_USE_FASTSEEK=y
CONFIG_FATFS_MAX_LFN=255

# LVGL
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_BUILD_EXAMPLES=n
# LVGL allocates through the C heap (large blocks land in PSRAM) instead of a
# static internal-RAM pool, which does not fit next to the P4's other .bss.
# LVGL allocates from PSRAM (components/tab5-emu/src/lv_mem_core_psram.c)
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_THEME_DEFAULT=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_THEME_DEFAULT_GROW=y
CONFIG_LV_THEME_DEFAULT_TRANSITION_TIME=30
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y

# LVGL: load boxart straight from the SD card (baseline JPEG via TJpgDec)
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=83
CONFIG_LV_FS_POSIX_PATH=""
CONFIG_LV_FS_POSIX_CACHE_SIZE=4096
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_SNAPSHOT=y
# no custom assert handler header (the old "assert.h" default is deprecated in
# LVGL 9.6 and its #warning is an error under -Werror)
CONFIG_LV_ASSERT_HANDLER_INCLUDE=""

# USB host on the USB-A port: keyboard / mouse (HID), through hubs too
CONFIG_USB_HOST_HUBS_SUPPORTED=y
# the P4's USB DMA can read PSRAM; internal RAM is too scarce for the
# 512-byte-aligned transfer descriptor lists once the game is running
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y

# LVGL image cache (PSRAM via lv_malloc): without it the JPEG decoder yields
# partially decoded images, which LVGL cannot scale (boxart never showed)
CONFIG_LV_CACHE_DEF_SIZE=65536

# USB mass storage (espp::UsbDevice MSC over the SD card)
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=8192
CONFIG_TINYUSB_CDC_ENABLED=n
CONFIG_FATFS_USE_LABEL=y

# core dumps to flash (printed base64 on the next boot, see Tab5Emu::dump_core_dump_to_console)
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# NOT 400 MHz: this Tab5 (chip v1.3, eco2 ROM) boot-loops in the ROM clock setup
# (Store/AMO fault at 0x50091000) with CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400.
