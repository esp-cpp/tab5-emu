menu "tab5-emu"

    config TAB5_EMU_AUTOSTART_DELAY_MS
        int "Auto-start the first game after this many ms (0 = off)"
        default 0
        help
            Bring-up aid: launch the first entry of metadata.csv automatically
            a little after boot, as if Play had been pressed.

    config TAB5_EMU_USB_MSC_AT_BOOT
        bool "Test: turn the USB drive on right after boot"
        default n
        help
            Development aid: enable USB mass storage (the SD card as a USB
            drive) as soon as the GUI is up, without touching the screen.

endmenu
